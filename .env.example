# Deployment settings for docker-compose.yml.
# Copy to .env (gitignored) and edit the values.

# The domain whose A/AAAA record points at this host, e.g. reach.example.com.
# Caddy gets a trusted TLS certificate for it over ports 80/443.
DOMAIN=reach.example.com

# Email for Let's Encrypt/ACME expiry notices. Optional but recommended.
ACME_EMAIL=you@example.com

# Absolute path to the firstmate home on this host (contains bin/, state/, data/).
FM_HOME=/home/you/firstmate

# Bearer token the phone uses under Settings. Generate with:
#   openssl rand -hex 32
FM_WT_TOKEN=replace-with-a-generated-token

# Host uid:gid that owns FM_HOME, so notes written into it stay owned by you.
# `id -u` and `id -g` print them. Default 1000.
PUID=1000
PGID=1000
