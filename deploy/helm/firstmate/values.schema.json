{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "firstmate chart values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "imagePullSecrets": { "type": "array" },
    "firstmate": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "home": { "type": "string", "pattern": "^/" },
        "herdrSession": { "type": "string", "minLength": 1 },
        "harnessCommand": { "type": "string" },
        "extraEnv": { "type": "array" },
        "extraEnvFrom": { "type": "array" },
        "command": { "type": "array" },
        "args": { "type": "array" },
        "resources": { "type": "object" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" }
      }
    },
    "walkieTalkie": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "extraEnv": { "type": "array" },
        "extraEnvFrom": { "type": "array" },
        "resources": { "type": "object" },
        "securityContext": { "type": "object" },
        "herdrCLI": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "mountPath": { "type": "string", "pattern": "^/" },
            "binary": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "storageClass": { "type": ["string", "null"] },
        "accessModes": { "type": "array", "items": { "type": "string" } },
        "size": { "type": "string" },
        "existingClaim": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "namespace"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "namespace": { "type": "string", "minLength": 1 },
              "sectionName": { "type": "string" }
            }
          }
        },
        "hostnames": { "type": "array", "items": { "type": "string" } },
        "annotations": { "type": "object" },
        "redirect": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "parentRefs": { "type": "array" }
          }
        }
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "secretName": { "type": "string" },
        "issuerRef": { "type": "object" },
        "dnsNames": { "type": "array", "items": { "type": "string" } },
        "duration": { "type": "string" },
        "renewBefore": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "existingSecret": { "type": "string" },
        "githubTokenEnabled": { "type": "boolean" },
        "create": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "walkieTalkieToken": { "type": "string" },
            "githubToken": { "type": "string" },
            "harness": { "type": "object" }
          }
        },
        "keys": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "walkieTalkieToken": { "type": "string", "minLength": 1 },
            "githubToken": { "type": "string", "minLength": 1 },
            "harness": { "type": "object" }
          }
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "harnesses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "env": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string" },
              "npm": { "type": "string" },
              "baseURL": { "type": "string" },
              "apiKeyEnv": { "type": "string", "minLength": 1 },
              "models": { "type": "object" },
              "options": { "type": "object" }
            }
          }
        },
        "dispatch": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "rules": { "type": "array" },
            "default": {
              "oneOf": [
                { "type": "array" },
                { "type": "object" }
              ]
            }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "description": "Multi-user gateway. Secret values are never accepted inline: only Secret references.",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "publicOrigin": { "type": "string" },
        "githubClientId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{0,100}$" },
        "admins": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "accessRequests": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" } }
        },
        "legacyBearer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "tokenSecretRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "name": { "type": "string" }, "key": { "type": "string" } }
            }
          }
        },
        "staticTenants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["githubId", "upstream", "tokenSecretRef"],
            "properties": {
              "githubId": { "type": "integer", "minimum": 1 },
              "upstream": { "type": "string", "pattern": "^https?://[^/?#@]+/?$" },
              "tokenSecretRef": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "key"],
                "properties": { "name": { "type": "string", "minLength": 1 }, "key": { "type": "string", "minLength": 1 } }
              }
            }
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": { "type": "string" },
            "keys": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "githubClientSecret": { "type": "string", "minLength": 1 },
                "vaultKeys": { "type": "string", "minLength": 1 },
                "tenantTokenSecret": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "vault": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "activeKey": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" } }
        },
        "trustedProxyHops": { "type": "integer", "minimum": 0, "maximum": 5 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "internalPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "internalPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "annotations": { "type": "object" }
          }
        },
        "tenantNamespace": { "type": "string" },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "storageClass": { "type": ["string", "null"] },
            "accessModes": { "type": "array", "items": { "type": "string" } },
            "size": { "type": "string" },
            "existingClaim": { "type": "string" },
            "annotations": { "type": "object" }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" } }
        },
        "resources": { "type": "object" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "extraEnv": { "type": "array" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "priorityClassName": { "type": "string" },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "gatewayNamespace": { "type": "string" }
      }
    }
  }
}
