  "statefulSet": {
    "apiVersion": "apps/v1",
    "kind": "StatefulSet",
    "metadata": {
      "name": "fm-uk7m2p9q",
      "namespace": "firstmate-tenants",
      "labels": {
        "app.kubernetes.io/name": "firstmate-tenant",
        "walkie-talkie.atus.hr/tenant": "uk7m2p9q",
        "app.kubernetes.io/component": "tenant",
        "app.kubernetes.io/managed-by": "walkie-talkie-gateway"
      }
    },
    "spec": {
      "serviceName": "fm-uk7m2p9q",
      "replicas": 1,
      "podManagementPolicy": "OrderedReady",
      "updateStrategy": {
        "type": "RollingUpdate"
      },
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/name": "firstmate-tenant",
          "walkie-talkie.atus.hr/tenant": "uk7m2p9q"
