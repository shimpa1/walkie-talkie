                  "name": "HOME",
                  "value": "/home/firstmate"
                },
                {
                  "name": "FM_HOME",
                  "value": "/home/firstmate"
                },
                {
                  "name": "FM_BIN",
                  "value": "/home/firstmate/bin"
                },
                {
                  "name": "HERDR_SESSION",
                  "value": "firstmate"
                },
                {
                  "name": "FM_HARNESS_COMMAND",
                  "value": "OPENCODE_CONFIG_CONTENT='{\"permission\":{\"*\":\"allow\"}}' opencode --prompt \"$FM_PRIMARY_SESSION_START_PROMPT\""
                },
                {
                  "name": "FM_READY_FILE",
                  "value": "/tmp/firstmate-ready"
                },
                {
                  "name": "FM_TENANT_CREDENTIALS_URL",
                  "value": "http://firstmate-gateway-internal.firstmate.svc:8788/internal/v1/credentials"
                },
                {
                  "name": "FM_TENANT_CREDENTIALS_TOKEN",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "fm-uk7m2p9q-tokens",
                      "key": "credentials"
                    }
                  }
                },
                {
                  "name": "FM_TENANT_CREDENTIAL_ENVS",
                  "value": "ANTHROPIC_API_KEY GH_TOKEN GITHUB_TOKEN"
                },
                {
                  "name": "FM_TENANT_REQUIRED_ENV",
                  "value": "ANTHROPIC_API_KEY"
                }
              ],
              "readinessProbe": {
                "exec": {
                  "command": [
                    "test",
                    "-e",
                    "/tmp/firstmate-ready"
                  ]
                },
                "initialDelaySeconds": 5,
                "periodSeconds": 10,
                "timeoutSeconds": 5,
                "failureThreshold": 3
              },
              "volumeMounts": [
                {
                  "name": "home",
                  "mountPath": "/home/firstmate"
                },
                {
                  "name": "agents",
                  "mountPath": "/home/firstmate/config/crew-dispatch.json",
                  "subPath": "crew-dispatch.json",
                  "readOnly": true
                },
                {
                  "name": "agents",
                  "mountPath": "/home/firstmate/.config/opencode/opencode.json",
                  "subPath": "opencode.json",
                  "readOnly": true
                }
              ],
              "resources": {
                "requests": {
                  "cpu": "250m",
                  "memory": "512Mi"
                },
                "limits": {
                  "memory": "2Gi",
                  "ephemeral-storage": "4Gi"
                }
              },
              "securityContext": {
                "runAsNonRoot": true,
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "seccompProfile": {
                  "type": "RuntimeDefault"
                }
              }
            },
            {
              "name": "walkie-talkie",
              "image": "shimpa/walkie-talkie:ba9876543210",
              "imagePullPolicy": "IfNotPresent",
              "ports": [
                {
                  "name": "walkie-talkie",
                  "containerPort": 8787,
                  "protocol": "TCP"
                }
              ],
              "env": [
                {
                  "name": "FM_HOME",
                  "value": "/home/firstmate"
                },
                {
                  "name": "FM_BIN",
                  "value": "/home/firstmate/bin"
                },
                {
                  "name": "HERDR_SESSION",
                  "value": "firstmate"
                },
                {
                  "name": "FM_WT_HOST",
                  "value": "0.0.0.0"
                },
                {
                  "name": "FM_WT_PORT",
                  "value": "8787"
                },
                {
                  "name": "FM_WT_ALLOW_PUBLIC_BIND",
                  "value": "1"
                },
                {
                  "name": "FM_WT_TOKEN",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "fm-uk7m2p9q-tokens",
                      "key": "api"
                    }
                  }
                },
                {
                  "name": "FM_WT_HERDR_BIN",
                  "value": "/opt/herdr/herdr"
                },
                {
                  "name": "XDG_CONFIG_HOME",
                  "value": "/home/firstmate/.config"
                },
                {
                  "name": "FM_WT_PUSH_STORE",
                  "value": "/home/firstmate/.walkie-talkie/push.json"
                }
              ],
              "livenessProbe": {
                "tcpSocket": {
                  "port": "walkie-talkie"
                },
                "initialDelaySeconds": 10,
                "periodSeconds": 20,
                "timeoutSeconds": 5,
                "failureThreshold": 3
              },
              "readinessProbe": {
                "httpGet": {
                  "path": "/api/health",
                  "port": "walkie-talkie"
                },
                "initialDelaySeconds": 5,
                "periodSeconds": 10,
                "timeoutSeconds": 5,
                "failureThreshold": 3
              },
              "volumeMounts": [
                {
                  "name": "home",
                  "mountPath": "/home/firstmate"
                },
                {
                  "name": "herdr-bin",
                  "mountPath": "/opt/herdr",
                  "readOnly": true
                }
              ],
              "resources": {
                "requests": {
                  "cpu": "50m",
                  "memory": "64Mi"
                },
                "limits": {
                  "memory": "256Mi"
                }
              },
              "securityContext": {
                "runAsNonRoot": true,
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "seccompProfile": {
                  "type": "RuntimeDefault"
