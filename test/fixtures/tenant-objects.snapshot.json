      "crew-dispatch.json": "{\n  \"rules\": [\n    {\n      \"when\": \"Mechanical or routine implementation, or other work with a settled plan and a bounded path.\",\n      \"use\": [\n        {\n          \"harness\": \"opencode\",\n          \"model\": \"anthropic/claude-haiku-4-5\"\n        }\n      ]\n    }\n  ],\n  \"default\": [\n    {\n      \"harness\": \"opencode\",\n      \"model\": \"anthropic/claude-sonnet-5-5\"\n    }\n  ]\n}\n"
