            "labels": {
              "app.kubernetes.io/name": "firstmate-tenant",
              "walkie-talkie.atus.hr/tenant": "uk7m2p9q",
              "app.kubernetes.io/component": "tenant",
              "app.kubernetes.io/managed-by": "walkie-talkie-gateway"
