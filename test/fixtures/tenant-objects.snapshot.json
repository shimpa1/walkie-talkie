      },
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/name": "firstmate-tenant",
            "walkie-talkie.atus.hr/tenant": "uk7m2p9q",
            "app.kubernetes.io/component": "tenant",
            "app.kubernetes.io/managed-by": "walkie-talkie-gateway"
          },
          "annotations": {
            "walkie-talkie.atus.hr/config-version": "3",
            "checksum/agents": "c86b768844eae253ed32db6153965665bd7da7a14d59face3f5dd34dc8930683"
          }
        },
        "spec": {
          "serviceAccountName": "fm-tenant",
          "automountServiceAccountToken": false,
          "enableServiceLinks": false,
          "securityContext": {
            "runAsUser": 1000,
            "runAsGroup": 1000,
            "runAsNonRoot": true,
            "fsGroup": 1000,
            "fsGroupChangePolicy": "OnRootMismatch",
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "terminationGracePeriodSeconds": 30,
